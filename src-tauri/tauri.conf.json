
{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MediaConverter",
  "version": "0.1.0",
  "identifier": "com.mediaconverter.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MediaConverter — Arcane Edition",
        "width": 1440,
        "height": 940,
        "minWidth": 900,
        "minHeight": 700,
        "resizable": true
      }
    ],
    "security": {
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "app"],
    "icon": [
      "icons/icon.ico"
    ],
    "resources": [
      "binaries/ffmpeg.exe",
      "binaries/ffprobe.exe"
    ]
  }
}
