
{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MediaConverter",
  "version": "0.1.0",
  "identifier": "com.mediaconverter.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MediaConverter — Arcane Edition",
        "width": 1440,
        "height": 940,
        "minWidth": 900,
        "minHeight": 700,
        "resizable": true
      }
    ],
    "security": {
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis", "dmg", "app"],
    "icon": ["icons/icon.ico"],
    "resources": [
      "binaries/ffmpeg.exe",
      "binaries/ffprobe.exe"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaW5nIHB1YmxpYyBrZXk6IEE3Q0I0OUUwRUJGRDkwNUYKUldSZmtQM3I0RW5McDB6RjJrdmpJQjFzVkMxUEp1NDczTEhqOGgrTk4rYTMxZDNvSXZvVDhaZ0oK",
      "endpoints": [
        "https://github.com/vilian743/MediaConverter/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
